{
  "name": "@dftp/server",
  "version": "2.0.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test --allow-all",
    "coverage": "deno test --allow-all --coverage=coverage/ && deno coverage coverage/",
    "coverage:html": "deno test --allow-all --coverage=coverage/ && deno coverage coverage/ --html",
    "dev": "deno run --allow-all src/cli/mod.ts serve",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/io": "jsr:@std/io@^0.225.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/datetime": "jsr:@std/datetime@^0.225.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@cliffy/table": "jsr:@cliffy/table@^1.0.0-rc.7",
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.0.0-rc.7",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@node-rs/argon2": "npm:@node-rs/argon2@^2.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": false
  },
  "exclude": [
    "tests/",
    "tools/",
    "assets/",
    "coverage/",
    ".github/"
  ],
  "allowScripts": ["npm:better-sqlite3@11.10.0"]
}
